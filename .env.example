# Copie para .env e preencha. Nunca commite o .env.

# Pelo menos uma chave de provider
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Opcional — se preenchida, POST /chat exige header X-Jarvis-Key
JARVIS_GATEWAY_KEY=

# Opcional — origens CORS separadas por vírgula. * = aberto
CORS_ORIGINS=*

HOST=0.0.0.0
PORT=8000
